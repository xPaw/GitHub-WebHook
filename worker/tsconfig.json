{
	"compilerOptions": {
		// No DOM, the runtime globals come from worker-configuration.d.ts
		"lib": ["esnext"],
		// Only the tests use node, its web globals overlap with the workers runtime types
		"types": ["node"],
		"skipLibCheck": true,
		"noEmit": true,
		"verbatimModuleSyntax": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true
	},
	// worker-configuration.d.ts is generated by `wrangler types`, which `npm run typecheck` runs first
	"include": ["worker-configuration.d.ts", "src", "test"]
}
